FKL_ENVIRONMENT=development
FKL_DATABASE_URL=sqlite:///./fact_knowledge_layer.db
FKL_LLM_PROVIDER=gemini
FKL_LLM_MODEL=gemini-3.5-flash-lite
FKL_GEMINI_API_KEY=
FKL_OPENAI_API_KEY=
FKL_EXTRACTION_BATCH_CHAR_LIMIT=50000
FKL_EXTRACTION_BATCH_PAGE_LIMIT=8
FKL_EVIDENCE_FUZZY_THRESHOLD=92
FKL_FISCAL_YEAR_START_MONTH=4
FKL_ALIAS_CONFIG_PATH=config/aliases.example.json
FKL_AMBIGUOUS_ENTITY_MATCHING_ENABLED=true
FKL_AMBIGUOUS_ENTITY_LOWER_SIMILARITY=0.82
FKL_AMBIGUOUS_ENTITY_UPPER_SIMILARITY=0.97
FKL_AMBIGUOUS_ENTITY_MAX_PAIRS=20
FKL_LLM_MAX_ATTEMPTS=4
FKL_LLM_RETRY_BASE_SECONDS=2
